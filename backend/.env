# =====================================================================
# AI-Adaptive Blood Donor Matching System — Environment Configuration
# Template file: Copy to .env for local runtime configuration
# =====================================================================

# Server Settings
ENVIRONMENT=development
PORT=8001
HOST=0.0.0.0

# Database Configuration
# In development, in-memory MongoDB fallback activates automatically if MongoDB is not running.
MONGODB_URL=mongodb://localhost:27017
DB_NAME=ai_blood_donor_db

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Automated Benchmark Seeding
AUTO_SEED_DATA=true

# Frontend Configuration (used by Vite client)
VITE_API_BASE_URL=http://localhost:8001
VITE_WS_URL=ws://localhost:8001/ws
